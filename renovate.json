{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "customManagers:biomeVersions"],
	"enabledManagers": ["bun", "cargo", "git-submodules", "github-actions"],
	"cloneSubmodules": true,
	"ignorePaths": ["**/dist/**", "vendor/**", "public/**", ".opencode/**"],

	"schedule": ["before 5am on Monday"],
	"timezone": "America/Montreal",
	"labels": ["dependencies"],
	"packageRules": [
		{
			"description": "Automerge non-major devDependency updates",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		},
		{
			"description": "Group all non-major Bun updates into a single PR",
			"matchManagers": ["bun"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "bun non-major dependencies",
			"groupSlug": "bun-non-major"
		},
		{
			"description": "Group all non-major Cargo updates into a single PR",
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "cargo non-major dependencies",
			"groupSlug": "cargo-non-major"
		},
		{
			"description": "Group all Cargo digest updates into a single PR",
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["digest"],
			"groupName": "cargo dependency digests",
			"groupSlug": "cargo-digests"
		},
		{
			"description": "Separate major updates for individual review",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"labels": ["dependencies", "major-update"]
		},
		{
			"description": "Enable git submodule updates",
			"matchManagers": ["git-submodules"],
			"enabled": true
		},
		{
			"description": "Group Tauri plugins and core together",
			"groupName": "Tauri packages",
			"groupSlug": "tauri",
			"matchPackageNames": ["@tauri-apps/{/,}**", "tauri{/,}**", "tauri-{/,}**"]
		},
		{
			"description": "Group Tanstack packages together",
			"groupName": "Tanstack packages",
			"groupSlug": "tanstack",
			"matchPackageNames": ["@tanstack/{/,}**"]
		}
	]
}
