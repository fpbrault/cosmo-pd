{
	"name": "cosmo-presets-library",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/*/webview",
		"packages/cosmo-pd101/site"
	],
	"scripts": {
		"postinstall": "bun run ./scripts/install-wasm-pack.mjs",
		"dev": "bun --filter @cosmo/cosmo-pd101-site dev",
		"build:engine": "bun --filter @cosmo/cosmo-synth-engine build:wasm",
		"build:web": "bun --filter @cosmo/cosmo-synth-engine build:wasm && cargo check -p cosmo-pd101-plugin --quiet && bun --filter @cosmo/cz-explorer build",
		"perf:engine": "cargo run -p cosmo-synth-engine --release --bin render-bench --",
		"perf:engine:all": "cargo run -p cosmo-synth-engine --release --bin render-bench -- --all --json",
		"perf:engine:hotspots": "cargo run -p cosmo-synth-engine --release --bin render-bench -- --suite hotspots --json",
		"perf:engine:bench": "cargo +nightly bench -p cosmo-synth-engine --bench render-bench -- --nocapture",
		"perf:engine:baseline": "mkdir -p target/perf/engine && cargo run -p cosmo-synth-engine --release --bin render-bench -- --all --json > target/perf/engine/baseline.json",
		"perf:engine:current": "mkdir -p target/perf/engine && cargo run -p cosmo-synth-engine --release --bin render-bench -- --all --json > target/perf/engine/current.json",
		"perf:engine:compare": "bun run ./scripts/perf-engine-compare.mjs target/perf/engine/baseline.json target/perf/engine/current.json",
		"perf:ui": "bun run ./scripts/perf-ui-benchmark.mjs",
		"perf:ui:compare": "bun run ./scripts/perf-ui-compare.mjs",
		"perf:web": "bun run ./scripts/perf-web-benchmark.mjs",
		"perf:bridge": "bun run ./scripts/perf-bridge-web.mjs",
		"perf:bridge:compare": "bun run ./scripts/perf-bridge-compare.mjs",
		"perf:bridge:benchmark": "bun run ./scripts/perf-bridge-benchmark.mjs",
		"build:plugin": "bun --filter @cosmo/cosmo-pd101-plugin build",
		"build:plugin:release": "bun --filter @cosmo/cosmo-pd101-plugin build",
		"build:plugin:auv3": "bun --filter @cosmo/cosmo-pd101-plugin-auv3 build",
		"build:plugin:auv3:ios": "bun --filter @cosmo/cosmo-pd101-plugin-auv3 build:ios",
		"bundle:plugin:auv3": "bun --filter cosmo-pd101-plugin-auv3 bundle",
		"install:plugin:auv3": "bun --filter @cosmo/cosmo-pd101-plugin-auv3 run plugin:install",
		"plugin:install": "bun --filter @cosmo/cosmo-pd101-plugin plugin:install",
		"package:plugin:installer": "bun run ./scripts/package-plugin-installers.mjs",
		"package:plugin:installer:macos": "bun run ./scripts/package-plugin-installers.mjs --platform macos",
		"package:plugin:installer:windows": "bun run ./scripts/package-plugin-installers.mjs --platform windows",
		"package:plugin:installer:linux": "bun run ./scripts/package-plugin-installers.mjs --platform linux",
		"test": "bun --filter '*' test && cargo test --workspace",
		"lint": "bunx biome check . && bun run ./scripts/cargo-fmt-workspace.mjs --check && cargo clippy --all-targets",
		"lint:fix:biome": "bunx biome check --write .",
		"lint:fix:cargo": "bun run ./scripts/cargo-fmt-workspace.mjs",
		"lint:fix": "bun run lint:fix:biome && bun run lint:fix:cargo && cargo clippy --fix --allow-dirty",
		"clean": "rimraf --glob packages/*/dist packages/**/lib-dist packages/*/target src-tauri/target target dist",
		"build": "bun run build:engine && bun --filter @cosmo/cosmo-pd101 build:lib:release && bun --filter @cosmo/cosmo-pd101-plugin build",
		"ci": "bun run lint && bun run build && bun run test"
	},
	"dependencies": {
		"tailwindcss": "^4.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"cross-env": "^10.1.0",
		"playwright": "^1.59.1",
		"rimraf": "^6.1.3"
	}
}
