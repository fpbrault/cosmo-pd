{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!.bench-commits",
			"!!**/dist",
			"!!**/lib-dist",
			"!!**/target",
			"!!vendor",
			"!!**/public/cosmo-synth-engine-wasm",
			"!!**/bindings/*.ts",
			"!!**/gen/schemas/*.json",
			"!!**/factory_presets.json"
		],
		"maxSize": 20000000
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"useSortedClasses": {
					"level": "on",
					"fix": "safe"
				}
			},
			"suspicious": {
				"noUnknownAtRules": {
					"level": "warn",
					"options": {
						"ignore": ["source", "theme", "plugin"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
