{
	"name": "@cosmo/cosmo-pd101-plugin",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build": "bun run build:release",
		"build:release": "bun run build:web && cargo truce build && bun run build:post:assets",
		"build:debug": "bun run build:web && cargo truce build --debug && bun run build:post:assets",
		"build:post:assets": "bash -c 'for d in ../../target/bundles/*/Contents/Resources; do mkdir -p \"$d/ui\" && cp -R webview/dist/* \"$d/ui/\"; done'",
		"build:web": "bun --filter @cosmo/cosmo-pd101-plugin-webview build",
		"plugin:install": "cargo truce install",
		"plugin:install:no-build": "cargo truce install --no-build",
		"dev": "cd webview && bun run dev:test",
		"test:unit": "cd webview && bun run test:unit",
		"test:unit:watch": "cd webview && bun run test:unit:watch",
		"test:browser": "cd webview && bun run test:browser",
		"test:all": "cd webview && bun run test:all",
		"test:e2e": "cd webview && bun run test:e2e",
		"test:e2e:ui": "cd webview && bun run test:e2e:ui",
		"test:e2e:debug": "cd webview && bun run test:e2e:debug",
		"package:release": "cargo truce package",
		"package:release:macos": "cargo truce package",
		"package:release:windows": "cargo truce package",
		"package:release:linux": "cargo truce package",
		"validate": "cargo truce validate --pluginval --auval",
		"validate:strict": "cargo truce validate --pluginval --auval -p cosmo-pd101-plugin",
		"uninstall": "cargo truce uninstall --vst3 --clap --au2"
	}
}
